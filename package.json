{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "受 CC-HAHA 启发、面向 DeepSeek Harness 的项目隔离持久记忆插件",
  "author": "yihefeikong-rgb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yihefeikong-rgb/dsh-cc-haha-memory.git"
  },
  "homepage": "https://github.com/yihefeikong-rgb/dsh-cc-haha-memory#readme",
  "bugs": {
    "url": "https://github.com/yihefeikong-rgb/dsh-cc-haha-memory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cc-haha",
    "memory",
    "persistent-memory"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
